  "item": [
    {
      "name": "API Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status test\", () => {\n    pm.response.to.have.status(200);\n});\n\nconst response = pm.response.json();\n\nconsole.log(response.status);\n\npm.test(\"Status should be ok\", () => {\n    pm.expect(response.status).to.eql(\"OK\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/status/",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "status",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "List of books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// first id that is non fiction and available\n\nconst response = pm.response.json();\n\nconst nonFictionBooks = response.filter(book => book.available === true);\nconst book = nonFictionBooks[0];\n// to make sure books are available\n\nif (book) {\n    pm.collectionVariables.set(\"bookId\", book.id);\n}\npm.test(\"Book found\", () => {\n    pm.expect(book).to.be.an('object');\n    pm.expect(book.available).to.be.true;\n    pm.expect(book.type).to.be.eql(\"non-fiction\");\n\n})\n\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/books?type=non-fiction",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "type",
              "value": "non-fiction"
            },
            {
              "key": "limit",
              "value": "20",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get single book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nconst response = pm.response.json();\npm.test(\"Is in stock\", function () {\n    pm.expect(response['current-stock']).to.be.above(0);\n});\n\npm.test(\"Book matches contract\", function () {\n    pm.response.to.have.jsonSchema({\n        type: 'object',\n        required: ['id', 'name', 'type', 'available', 'current-stock'],\n        properties: {\n            id: { type: 'integer' },\n            name: { type: 'string' },\n            type: { type: 'string' },\n            available: { type: 'boolean' },\n            'current-stock': { type: 'integer' }\n        }\n    });\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/books/:bookId",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "books",
            ":bookId"
          ],
          "variable": [
            {
              "key": "bookId",
              "value": "{{bookId}}"
            }
          ]
        }
      },
      "response": []
    },   
    {
      "name": "Register API client",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n   \"clientName\": \"Postman2\",\n   \"clientEmail\": \"{{$randomEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api-clients",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api-clients"
          ]
        }
